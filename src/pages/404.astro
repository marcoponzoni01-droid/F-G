---
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';
---

<Base path="/404" title="Not found" description="That page does not exist.">
	<div class="mx-auto max-w-2xl px-5 sm:px-8 py-20 text-center">
		<p class="label">Error 404</p>
		<h1 class="mt-3 font-serif text-3xl sm:text-4xl">No file under that reference.</h1>
		<p class="mt-4 text-ink-muted">
			The page you asked for is not here. It may have moved, or it may never have existed.
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a
				href={href('/')}
				class="border border-accent text-accent px-4 py-2 text-sm no-underline transition-colors hover:bg-accent-soft"
			>
				This week's issue
			</a>
			<a
				href={href('/archive')}
				class="border border-line-strong px-4 py-2 text-sm no-underline transition-colors hover:border-ink-muted"
			>
				Search the archive
			</a>
		</div>
	</div>
</Base>
