---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { getIssueIndex } from '../lib/issues';
import { href, issueHref } from '../lib/paths';
import { site } from '../config/site';

const { current } = await getIssueIndex();
---

<Base
	path="/subscribe"
	title="Subscribe"
	description={`${site.cadence}: one issue on how geopolitical events moved capital that week.`}
>
	<div class="mx-auto max-w-2xl px-5 sm:px-8 py-14">
		<p class="label">Subscribe</p>
		<h1 class="mt-3 font-serif text-3xl sm:text-4xl leading-tight">
			One issue a week. Nothing else.
		</h1>

		<div class="mt-6 space-y-4 text-[0.975rem] leading-relaxed text-ink-muted">
			<p>
				{site.cadence}, {site.name} covers the week's geopolitical events from one angle: the
				financial consequence. What moved, why it moved, and which part of the move was noise.
			</p>
			<p>
				Every issue also becomes a permanent, searchable
				<a href={href('/archive')} class="underline decoration-accent underline-offset-2 hover:text-ink">
					archive
				</a>
				entry — so nothing is lost if you read it three months late.
			</p>
		</div>

		<div class="mt-9">
			<NewsletterForm heading="Sign up" />
		</div>

		<section class="mt-12 border-t border-line pt-8">
			<h2 class="label">What an issue looks like</h2>
			{
				current ? (
					<a
						href={issueHref(current.id)}
						class="mt-4 block border border-line bg-surface p-5 no-underline transition-colors hover:border-line-strong"
					>
						<span class="font-serif text-lg leading-snug">{current.data.title}</span>
						<span class="mt-2 block text-sm leading-relaxed text-ink-muted">{current.data.dek}</span>
						<span class="label mt-3 block text-accent">Read the current issue →</span>
					</a>
				) : (
					<p class="mt-3 text-sm text-ink-muted">The first issue is on its way.</p>
				)
			}
		</section>

		<section class="mt-10 border-t border-line pt-8">
			<h2 class="label">Prefer no email?</h2>
			<p class="mt-3 text-sm leading-relaxed text-ink-muted">
				The
				<a href={href('/rss.xml')} class="underline decoration-accent underline-offset-2 hover:text-ink">
					RSS feed
				</a>
				carries every issue in full, and the archive is free and open — no account, no paywall.
			</p>
		</section>
	</div>
</Base>
