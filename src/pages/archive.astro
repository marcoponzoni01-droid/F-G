---
import Base from '../layouts/Base.astro';
import ArchiveExplorer from '../components/ArchiveExplorer.astro';
import { getIssueIndex } from '../lib/issues';
import { site } from '../config/site';

const { archive, current } = await getIssueIndex();
---

<Base
	path="/archive"
	title="Archive"
	description={`Every issue of ${site.name}, searchable by region, asset class, event type and date.`}
>
	<div class="mx-auto max-w-5xl px-5 sm:px-8 py-12">
		<p class="label">Archive</p>
		<h1 class="mt-3 font-serif text-3xl sm:text-4xl leading-tight">The record</h1>
		<p class="mt-4 max-w-2xl text-[0.975rem] leading-relaxed text-ink-muted">
			Every issue published, kept permanently and searchable by full text as well as by region,
			asset class, event type and date. Free, and no account required.
		</p>

		<div class="mt-9">
			{
				archive.length > 0 ? (
					<ArchiveExplorer issues={archive} currentId={current?.id} />
				) : (
					<p class="border border-line bg-surface p-6 text-sm text-ink-muted">
						The archive fills up as issues are published. Nothing here yet.
					</p>
				)
			}
		</div>
	</div>
</Base>
