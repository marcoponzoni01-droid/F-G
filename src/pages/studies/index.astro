---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { entryFromStudy } from '../../lib/archive';
import { getPublishedStudies, groupBySubjectKind } from '../../lib/studies';
import { href } from '../../lib/paths';
import { site } from '../../config/site';

const studies = await getPublishedStudies();
const groups = groupBySubjectKind(studies);
---

<Base
	path="/studies"
	title="Studies"
	description={`Standing pieces on how one economy, or one mechanism, transmits a shock — from ${site.name}.`}
>
	<div class="mx-auto max-w-5xl px-5 sm:px-8 py-12">
		<p class="label">Studies</p>
		<h1 class="mt-3 font-serif text-3xl sm:text-4xl leading-tight">The standing files</h1>
		<p class="mt-4 max-w-2xl text-[0.975rem] leading-relaxed text-ink-muted">
			The weekly issue reports what happened. A study explains the structure underneath it — how one
			country's economy transmits a shock, or how one mechanism works wherever it runs. Unlike an
			issue, a study is kept current: it carries the date it was last revised.
		</p>

		{
			groups.length > 0 ? (
				groups.map((group) => (
					<section class="mt-12">
						<div class="flex items-baseline justify-between gap-4 border-t border-line pt-6">
							<h2 class="label">{group.kind.label}</h2>
							<span class="label">
								{group.studies.length} {group.studies.length === 1 ? 'study' : 'studies'}
							</span>
						</div>
						<p class="mt-2 text-sm text-ink-faint">{group.kind.blurb}</p>
						<div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{group.studies.map((study) => (
								<EntryCard entry={entryFromStudy(study)} />
							))}
						</div>
					</section>
				))
			) : (
				<p class="mt-9 border border-line bg-surface p-6 text-sm text-ink-muted">
					No studies published yet. Add a file to
					<code class="font-mono">src/content/studies/</code> and it appears here.
				</p>
			)
		}

		<p class="mt-12 text-sm">
			<a href={href('/archive')} class="text-ink-muted no-underline hover:text-accent">
				Search everything, issues and studies together →
			</a>
		</p>

		<div class="mt-12">
			<NewsletterForm />
		</div>
	</div>
</Base>
