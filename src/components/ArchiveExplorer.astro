---
import EntryCard from './EntryCard.astro';
import { ASSETS, EVENT_TYPES, REGIONS } from '../config/taxonomy';
import type { ArchiveEntry } from '../lib/archive';
import { href } from '../lib/paths';

interface Props {
	entries: ArchiveEntry[];
	/** Id of the newest issue, badged in the results. */
	currentId?: string;
}

const { entries, currentId } = Astro.props;

// Only offer facet options that actually occur in the corpus — an empty filter
// is worse than a missing one.
const present = {
	regions: new Set(entries.flatMap((e) => e.regions)),
	assets: new Set(entries.flatMap((e) => e.assets)),
	types: new Set(entries.flatMap((e) => e.eventTypes)),
	kinds: new Set(entries.map((e) => e.kind)),
};

const regionOptions = REGIONS.filter((r) => present.regions.has(r));
const assetOptions = ASSETS.filter((a) => present.assets.has(a));
const typeOptions = EVENT_TYPES.filter((t) => present.types.has(t.id));

/** Offered only once the archive actually holds both kinds. */
const KINDS = [
	{ id: 'issue', label: 'Weekly issues' },
	{ id: 'study', label: 'Studies' },
] as const;
const showKindFacet = present.kinds.size > 1;

const control =
	'w-full bg-surface border border-line-strong px-2.5 py-2 text-sm text-ink focus:border-accent focus:outline-none';
---

<section data-archive data-index-url={href('/search-index.json')}>
	<form
		class="border border-line bg-surface p-4 sm:p-5"
		role="search"
		aria-label="Search the archive"
		data-archive-form
	>
		<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
			<div class="sm:col-span-2">
				<label class="label block mb-1.5" for="ar-q">Search</label>
				<input
					id="ar-q"
					type="search"
					name="q"
					placeholder="Sanctions, freight, sovereign debt…"
					class={control}
					autocomplete="off"
					data-filter="q"
				/>
			</div>

			{
				showKindFacet && (
					<div>
						<label class="label block mb-1.5" for="ar-kind">
							Kind
						</label>
						<select id="ar-kind" name="kind" class={control} data-filter="kind">
							<option value="">Everything</option>
							{KINDS.map((kind) => (
								<option value={kind.id}>{kind.label}</option>
							))}
						</select>
					</div>
				)
			}

			<div>
				<label class="label block mb-1.5" for="ar-type">Event type</label>
				<select id="ar-type" name="type" class={control} data-filter="type">
					<option value="">All types</option>
					{typeOptions.map((type) => <option value={type.id}>{type.label}</option>)}
				</select>
			</div>

			<div>
				<label class="label block mb-1.5" for="ar-region">Region</label>
				<select id="ar-region" name="region" class={control} data-filter="region">
					<option value="">All regions</option>
					{regionOptions.map((region) => <option value={region}>{region}</option>)}
				</select>
			</div>

			<div>
				<label class="label block mb-1.5" for="ar-asset">Asset class</label>
				<select id="ar-asset" name="asset" class={control} data-filter="asset">
					<option value="">All assets</option>
					{assetOptions.map((asset) => <option value={asset}>{asset}</option>)}
				</select>
			</div>

			<div>
				<label class="label block mb-1.5" for="ar-from">From</label>
				<input id="ar-from" type="date" name="from" class={control} data-filter="from" />
			</div>

			<div>
				<label class="label block mb-1.5" for="ar-to">To</label>
				<input id="ar-to" type="date" name="to" class={control} data-filter="to" />
			</div>

			<div class="flex items-end">
				<button
					type="button"
					class="w-full border border-line-strong px-3 py-2 text-sm transition-colors hover:border-ink-muted disabled:opacity-40"
					data-archive-clear
					disabled
				>
					Clear filters
				</button>
			</div>
		</div>
	</form>

	<noscript>
		<p class="mt-3 text-sm text-ink-faint">
			Search and filtering need JavaScript. Everything is listed in full below.
		</p>
	</noscript>

	<p class="mt-5 label" role="status" aria-live="polite" data-archive-count>
		{entries.length}
		{entries.length === 1 ? 'entry' : 'entries'}
	</p>

	<ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-archive-results>
		{
			entries.map((entry) => (
				<li data-issue-id={entry.id} data-kind={entry.kind}>
					<EntryCard entry={entry} current={entry.id === currentId} />
				</li>
			))
		}
	</ul>

	<p class="mt-8 hidden text-center text-sm text-ink-muted" data-archive-empty>
		Nothing matches those filters.
		<button type="button" class="underline decoration-accent underline-offset-2" data-archive-clear>
			Clear them
		</button>
		to see everything.
	</p>
</section>

<script>
	import Fuse from 'fuse.js';

	/** Mirrors SearchRecord in src/lib/archive.ts. */
	interface SearchRecord {
		kind: 'issue' | 'study';
		id: string;
		title: string;
		dek: string;
		summary: string;
		date: string;
		subject?: string;
		regions: string[];
		assets: string[];
		eventTypes: string[];
		tags: string[];
		body: string;
	}

	type FilterName = 'q' | 'kind' | 'type' | 'region' | 'asset' | 'from' | 'to';

	const root = document.querySelector<HTMLElement>('[data-archive]');

	if (root) {
		const controls = new Map<FilterName, HTMLInputElement | HTMLSelectElement>();
		root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-filter]').forEach((el) => {
			controls.set(el.dataset.filter as FilterName, el);
		});

		// The server-rendered cards stay the source of truth; filtering only ever
		// hides and shows them. If anything below fails, the full list survives.
		const cards = new Map<string, HTMLElement>();
		root.querySelectorAll<HTMLElement>('[data-issue-id]').forEach((el) => {
			cards.set(el.dataset.issueId ?? '', el);
		});

		const countEl = root.querySelector<HTMLElement>('[data-archive-count]');
		const emptyEl = root.querySelector<HTMLElement>('[data-archive-empty]');
		const clearButtons = root.querySelectorAll<HTMLButtonElement>('[data-archive-clear]');
		const total = cards.size;

		let records: SearchRecord[] = [];
		let fuse: Fuse<SearchRecord> | null = null;

		const read = (name: FilterName) => controls.get(name)?.value.trim() ?? '';

		function hydrateFromUrl() {
			const params = new URLSearchParams(window.location.search);
			for (const [name, el] of controls) {
				const value = params.get(name);
				if (!value) continue;
				// Ignore a facet value that is not an option here (e.g. a stale link).
				if (el instanceof HTMLSelectElement && !Array.from(el.options).some((o) => o.value === value))
					continue;
				el.value = value;
			}
		}

		function syncUrl() {
			const params = new URLSearchParams();
			for (const name of controls.keys()) {
				const value = read(name);
				if (value) params.set(name, value);
			}
			const query = params.toString();
			window.history.replaceState(
				null,
				'',
				query ? `${window.location.pathname}?${query}` : window.location.pathname,
			);
		}

		/**
		 * Literal first; fuzzy only when literal finds nothing.
		 *
		 * Fuzzy matching alone stops discriminating as the corpus grows — a
		 * 3,000-character body nearly always contains *something* within the edit
		 * distance, and even short fields betray you: "Italy" matches "capital" in
		 * another entry's tags, because "ital" is right there inside it.
		 * Tightening the threshold far enough to stop that also stops "sanctons"
		 * finding the sanctions issue, which is the one thing fuzziness is for.
		 *
		 * So the two are ordered rather than merged. If anything contains the
		 * query as typed, those are the results — that is what the reader asked
		 * for. Only when nothing does is fuzziness allowed to answer, which turns
		 * it into the "did you mean" it should always have been.
		 */
		function search(q: string): Set<string> {
			const needle = q.toLowerCase();

			const literal = records
				.filter((record) =>
					[
						record.title,
						record.subject ?? '',
						record.dek,
						record.summary,
						record.body ?? '',
						record.tags.join(' '),
						record.regions.join(' '),
						record.assets.join(' '),
					]
						.join(' ')
						.toLowerCase()
						.includes(needle),
				)
				.map((record) => record.id);

			if (literal.length > 0) return new Set(literal);

			return new Set(fuse ? fuse.search(q).map((r) => r.item.id) : []);
		}

		function apply() {
			const q = read('q');
			const kind = read('kind');
			const type = read('type');
			const region = read('region');
			const asset = read('asset');
			const from = read('from');
			const to = read('to');

			const anyFilter = Boolean(q || kind || type || region || asset || from || to);
			clearButtons.forEach((button) => {
				button.disabled = !anyFilter;
			});

			// No index yet (still loading, or the fetch failed): leave everything visible
			// rather than showing a filtered view built on nothing.
			if (records.length === 0) {
				syncUrl();
				return;
			}

			const matched = q.length >= 2 ? search(q) : null;

			let visible = 0;
			for (const record of records) {
				const ok =
					(!matched || matched.has(record.id)) &&
					(!kind || record.kind === kind) &&
					// An issue has one event type and a study has several, so both are
					// arrays here and this is the same test as region and asset.
					(!type || record.eventTypes.includes(type)) &&
					(!region || record.regions.includes(region)) &&
					(!asset || record.assets.includes(asset)) &&
					// Dates are ISO yyyy-mm-dd, so string comparison is date comparison.
					(!from || record.date >= from) &&
					(!to || record.date <= to);

				const card = cards.get(record.id);
				if (card) card.style.display = ok ? '' : 'none';
				if (ok) visible += 1;
			}

			if (countEl) {
				// The noun agrees with the total, not the match count: "1 of 9 entries".
				const noun = total === 1 ? 'entry' : 'entries';
				countEl.textContent = anyFilter ? `${visible} of ${total} ${noun}` : `${total} ${noun}`;
			}
			emptyEl?.classList.toggle('hidden', visible > 0);

			syncUrl();
		}

		function clear() {
			for (const el of controls.values()) el.value = '';
			apply();
			controls.get('q')?.focus();
		}

		for (const el of controls.values()) {
			el.addEventListener('input', apply);
			el.addEventListener('change', apply);
		}
		clearButtons.forEach((button) => button.addEventListener('click', clear));

		root.querySelector('[data-archive-form]')?.addEventListener('submit', (event) => {
			event.preventDefault();
			apply();
		});

		hydrateFromUrl();

		function start(data: SearchRecord[]) {
			records = data;
			fuse = new Fuse(records, {
				// Short fields only. `dek`, `summary` and `body` are matched
				// literally instead — see search() above.
				keys: [
					{ name: 'title', weight: 3 },
					// A study is looked up by what it is about as often as by its title.
					{ name: 'subject', weight: 3 },
					{ name: 'tags', weight: 2 },
					{ name: 'regions', weight: 1.5 },
					{ name: 'assets', weight: 1.5 },
				],
				/*
				 * Tight, because this layer's only job is typo tolerance.
				 *
				 * One dropped character in a word of eight or nine scores around
				 * 0.11–0.15, so 0.2 still finds "sanctons" and "freigt". Anything
				 * looser starts matching a short query against *something* in a long
				 * tag list: at 0.34 with ten records, "Italy" returned the Italy
				 * study plus two issues that have nothing to do with it.
				 */
				threshold: 0.2,
				ignoreLocation: true,
				minMatchCharLength: 3,
			});
			apply();
		}

		/**
		 * An index already embedded in the page wins over fetching one.
		 *
		 * The normal path is the fetch below: the index is its own build artefact,
		 * so it caches separately from the HTML. But this same markup is also
		 * exported as a single self-contained file for design work, and there a
		 * relative fetch resolves to nothing — leaving search and filters quietly
		 * dead on a page that otherwise looks completely fine.
		 */
		const embedded = document.getElementById('search-index')?.textContent;
		let ready = false;
		if (embedded) {
			try {
				start(JSON.parse(embedded));
				ready = true;
			} catch (error) {
				console.warn('[archive] embedded index unreadable, falling back to fetch', error);
			}
		}

		const indexUrl = root.dataset.indexUrl;
		if (!ready && indexUrl) {
			fetch(indexUrl)
				.then((response) => {
					if (!response.ok) throw new Error(`Search index responded ${response.status}`);
					return response.json() as Promise<SearchRecord[]>;
				})
				.then(start)
				.catch((error) => {
					// Degrade to the complete server-rendered list.
					console.warn('[archive] search index unavailable, showing all issues', error);
				});
		}
	}
</script>
