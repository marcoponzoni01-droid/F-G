---
import { eventTypeLabel } from '../config/taxonomy';
import { href } from '../lib/paths';

interface Props {
	regions?: readonly string[];
	assets?: readonly string[];
	/**
	 * One for an issue, several for a study — an issue covers one event and so
	 * one channel, while a study explains a structure several channels run
	 * through. Both arrive here as an array.
	 */
	eventTypes?: readonly string[];
	/** Chips link into the archive with that facet pre-selected. */
	linked?: boolean;
	class?: string;
}

const {
	regions = [],
	assets = [],
	eventTypes = [],
	linked = false,
	class: className = '',
} = Astro.props;

const base =
	'inline-block border px-2 py-0.5 text-xs leading-5 whitespace-nowrap no-underline transition-colors';

type Chip = { label: string; facet: 'type' | 'region' | 'asset'; value: string; class: string };

const chips: Chip[] = [
	...eventTypes.map((type) => ({
		label: eventTypeLabel(type),
		facet: 'type' as const,
		value: type,
		class: 'border-accent text-accent bg-accent-soft',
	})),
	...regions.map((r) => ({
		label: r,
		facet: 'region' as const,
		value: r,
		class: 'border-line-strong text-ink-muted',
	})),
	...assets.map((a) => ({
		label: a,
		facet: 'asset' as const,
		value: a,
		class: 'border-line text-ink-faint',
	})),
];
---

{
	chips.length > 0 && (
		<ul class:list={['flex flex-wrap gap-1.5', className]}>
			{chips.map((chip) => (
				<li>
					{linked ? (
						<a
							href={`${href('/archive')}?${chip.facet}=${encodeURIComponent(chip.value)}`}
							class:list={[base, chip.class, 'hover:text-ink hover:border-ink-muted']}
						>
							{chip.label}
						</a>
					) : (
						<span class:list={[base, chip.class]}>{chip.label}</span>
					)}
				</li>
			))}
		</ul>
	)
}
